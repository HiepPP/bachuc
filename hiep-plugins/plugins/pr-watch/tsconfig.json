{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "zod": ["../../../node_modules/zod"],
      "zod/*": ["../../../node_modules/zod/*"]
    },
    "typeRoots": ["../../../node_modules/@types", "./node_modules/@types"]
  },
  "include": ["**/*.ts"]
}
