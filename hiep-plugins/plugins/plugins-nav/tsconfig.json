{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["react", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "zod": ["../../../node_modules/zod"],
      "zod/*": ["../../../node_modules/zod/*"],
      "react": ["../../../node_modules/@types/react"],
      "react/*": ["../../../node_modules/@types/react/*"]
    },
    "typeRoots": ["../../../node_modules/@types", "./node_modules/@types"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
